# Copy to .env.local and fill in what you need.
# aurea runs fully offline without any of these — the Topic Pack feature
# falls back to the internal curriculum spine (no network, no key).

# ---- AI (Topic Packs only) ------------------------------------------
# Unset = offline mode: packs are built from the internal spine and cached.
AUREA_AI_API_KEY=
AUREA_AI_BASE_URL=https://api.openai.com/v1
AUREA_AI_MODEL=gpt-4o-mini

# ---- Optional web-search proxy (Tavily-style, POST /search) ---------
# If unset, packs retrieve straight from allowlisted domains via HTTPS.
AUREA_SEARCH_API_KEY=
AUREA_SEARCH_BASE_URL=https://api.tavily.com/search

# ---- Allowlist extras (comma separated, port ignored, subdomains excluded) --
# ALLOWLIST_DOMAINS=archive.org,mit.edu

# ---- Storage --------------------------------------------------------
# Data dir + path are resolved by @/lib/server/store/db.ts
# AUREA_DATA_DIR=
# AUREA_DB_PATH=

# ---- Pack cache TTL (ms). Documented; enforcement pending. ----------
# AUREA_TOPIC_PACK_TTL_MS=